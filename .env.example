# Required
NOVITA_API_KEY=your-novita-api-key
LITELLM_MASTER_KEY=sk-change-me
LITELLM_SALT_KEY=change-me-once-and-never-rotate

# Railway injects these from its Postgres and Redis services.
DATABASE_URL=postgresql://litellm:litellm@postgres:5432/litellm
REDIS_URL=redis://redis:6379

# Keep model configuration in config.yaml so only Novita models are exposed.
STORE_MODEL_IN_DB=False
